/*
FRAME STYLING (MINIMAL BLACK LINES)
We remove the wood texture and replace it with simple black borders.
*/
.frame-side {
position: fixed;
background-color: white;
/* No Border - lines are drawn by visual layer */
border: none;
display: flex;
justify-content: center;
align-items: center;
z-index: 1000;
box-sizing: border-box;
}
/*
Visual Layer for Diagonal Joints
Since clip-path cuts off borders at the diagonals, we draw specific lines.
*/
.frame-visuals {
position: fixed;
top: 0;
left: 0;
width: 100%;
height: 100%;
pointer-events: none;
z-index: 1002;
/* Above frame sides */
}
.outer-rect {
position: absolute;
top: var(--frame-inset);
left: var(--frame-inset);
right: var(--frame-inset);
bottom: var(--frame-inset);
border: 2px solid black;
}
.inner-rect {
position: absolute;
top: calc(var(--frame-inset) + var(--frame-thickness));
left: calc(var(--frame-inset) + var(--frame-thickness));
right: calc(var(--frame-inset) + var(--frame-thickness));
bottom: calc(var(--frame-inset) + var(--frame-thickness));
border: 2px solid black;
}
.corner-line {
position: absolute;
background-color: black;
height: 2px;
/*
Width = distance from outer corner to inner corner = thickness * sqrt(2)
55 * 1.414 = 77.78px.
Set to 77.5px to bridge the gap perfectly without overshooting visually.
*/
width: 77.8px;
transform-origin: 0 50%;
}
/*
Positioning corners at the "inset" point where bars meet.
*/
.corner-tl {
top: var(--frame-inset);
left: var(--frame-inset);
transform: rotate(45deg);
}
.corner-tr {
top: var(--frame-inset);
left: calc(100% - var(--frame-inset));
transform: rotate(135deg);
}
.corner-bl {
bottom: var(--frame-inset);
left: var(--frame-inset);
transform: rotate(-45deg);
}
.corner-br {
bottom: var(--frame-inset);
left: calc(100% - var(--frame-inset));
transform: rotate(-135deg);
}
/* TOP */
.frame-top {
top: var(--frame-inset);
left: var(--frame-inset);
right: var(--frame-inset);
height: var(--frame-thickness);
/* Mitered visual using clip-path */
clip-path: polygon(0% 0%, 100% 0%, calc(100% - var(--frame-thickness) + 1px) 100%, calc(var(--frame-thickness) - 1px) 100%);
}
/* BOTTOM */
.frame-bottom {
bottom: var(--frame-inset);
left: var(--frame-inset);
