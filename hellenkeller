function setupImageViewer(images) {
if (!images || images.length <= 1) return;
const viewer = document.querySelector('.image-viewer');
const img = viewer.querySelector('img');
let index = 0;
viewer.addEventListener('click', () => {
index = (index + 1) % images.length;
img.src = images[index];
});
}
function assignRandomLinks(excludeId) {
const available = pages.filter(p => p.id !== excludeId);
for (let i = available.length - 1; i > 0; i--) {
const j = Math.floor(Math.random() * (i + 1));
[available[i], available[j]] = [available[j], available[i]];
}
const selected = available.slice(0, 4);
const positions = ['top', 'right', 'bottom', 'left'];
positions.forEach((pos, index) => {
if (selected[index]) {
const el = document.getElementById('frame-' + pos);
const page = selected[index];
const label = el.querySelector('.label');
label.textContent = page.title;
el.title = page.title;
