bottom: var(--frame-inset);
left: var(--frame-inset);
width: var(--frame-thickness);
clip-path: polygon(0% 0%, 100% calc(var(--frame-thickness) - 1px), 100% calc(100% - var(--frame-thickness) + 1px), 0% 100%);
